# Application
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Database — SQLite for quick demos; Postgres for Docker / production-shaped runs
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg2://finops:finops@localhost:5432/finops_rag

# LLM — ollama | openai | mock
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
# Fail LLM explain after N seconds and keep ledger answer (avoids proxy hang-ups)
LLM_TIMEOUT_SECONDS=25
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings — local | openai | hash (hash = deterministic, offline/tests)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector store
CHROMA_PERSIST_DIR=./.chroma
CHROMA_COLLECTION=finops_chunks

# Paths
UPLOAD_DIR=./uploads
# FIXTURES_DIR=../fixtures
CHUNK_ROW_SIZE=12

# Frontend (browser uses same-origin /api via Next rewrite)
API_PROXY_TARGET=http://localhost:8000
